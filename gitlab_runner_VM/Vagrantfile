# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # --------------------------------------------------------------------------
  # VM SETTINGS
  # --------------------------------------------------------------------------
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "gitlab-runner"

  # Network (optional: bridged or private)
  # config.vm.network "public_network"
  config.vm.network "private_network", ip: "192.168.56.50"

  # Sync folder (where the repo is)
  config.vm.synced_folder ".", "/vagrant", type: "virtualbox"

  # --------------------------------------------------------------------------
  # PROVISIONING
  # --------------------------------------------------------------------------

  config.vm.provision "shell", inline: <<-SHELL
    # Install dependencies
    apt-get update -y
    apt-get install -y curl jq

    # Install GitLab Runner
    curl -L https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.deb.sh | bash
    apt-get install -y gitlab-runner

    # Make provisioning script executable
    chmod +x /vagrant/create_runner.sh
  SHELL

  # Run your script AFTER GitLab Runner is installed
  config.vm.provision "shell", path: "create_runner.sh"
end